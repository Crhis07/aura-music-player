<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.IOSMusicPlayer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Tema especial para la pantalla de bloqueo estilo iOS 16: verdaderamente inmersivo y sin barras negras -->
    <style name="Theme.IOSMusicPlayer.LockScreen" parent="Theme.IOSMusicPlayer">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
